ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional when testing `/wiki/ask` with `gpt-*` or `gemini-*` hosted model overrides.
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
# Optional local OpenAI-compatible LM Studio routing for all wiki LLM calls.
# WIKI_LLM_PROVIDER=lmstudio
# WIKI_LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# WIKI_LMSTUDIO_MODEL=your-local-model-id
# WIKI_LMSTUDIO_API_KEY=optional_bearer_token
# Optional when building or probing the experimental markdown Qdrant index.
# VOYAGE_API_KEY=your_voyage_api_key_here
# QDRANT_URL=http://127.0.0.1:6333
# WIKI_QDRANT_COLLECTION=foodex2_wiki_markdown_v1
# WIKI_EMBED_MODEL=voyage-context-3
# WIKI_EMBED_DIMENSION=1024
# SOURCE_QDRANT_COLLECTION=foodex2_source_docs_v1
# SOURCE_EMBED_MODEL=voyage-context-3
# SOURCE_EMBED_DIMENSION=1024
WIKI_LIBRARIAN_MODEL=claude-sonnet-4-6
# Optional endpoint-specific overrides.
# WIKI_POLICY_MODEL=claude-sonnet-4-6
# WIKI_CONTEXT_MODEL=claude-sonnet-5
WIKI_ANSWERER_MODEL=gpt-5.6-terra
# WIKI_SOLVER_MODEL=claude-sonnet-4-6
# WIKI_LINT_MODEL=claude-sonnet-4-6
# WIKI_INTAKE_MODEL=claude-sonnet-4-6
# Adaptive thinking is opt-in for offline maintenance because thinking tokens
# are billed output. Enable only for a review that needs deeper reasoning.
# WIKI_LINT_THINKING=1
# WIKI_INTAKE_THINKING=1

# Source-driven coverage evals. All four default-path models must be served by
# LM Studio; model IDs are resolved and recorded when a testset is generated/run.
# COVERAGE_LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# COVERAGE_GENERATOR_MODEL=your-local-moe-model-id
# COVERAGE_AUDITOR_MODEL=your-strong-local-auditor-model-id
# COVERAGE_SELECTOR_MODEL=your-local-selector-model-id
# COVERAGE_DMT_ANSWERER_MODEL=your-production-dmt-model-id
# COVERAGE_JUDGE_MODEL=your-strongest-local-judge-model-id
# Optional and used only with evals.coverage.run --escalate-judge.
# COVERAGE_ESCALATION_MODEL=gpt-5.6-terra
# DEEPEVAL_TELEMETRY_OPT_OUT=1  # enforced by the harness as well
