{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/foodex2-wiki/end-to-end-cases.schema.json",
  "title": "DMT Wiki Answer Evaluation Cases",
  "type": "object",
  "required": ["version", "cases"],
  "properties": {
    "version": {
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "reviewed", "question"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "reviewed": {
            "type": "boolean"
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "request_question": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "enum": [
              "pesticides",
              "contaminants",
              "vmpr",
              "additives",
              "none"
            ]
          },
          "shape": {
            "enum": [
              "dmt_standard",
              "agent_specific"
            ]
          },
          "reference_answer": {
            "type": "string",
            "minLength": 1
          },
          "reference_pages": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "acceptable_pages": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "must_not_pages": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "required_answer_terms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "forbidden_answer_terms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "rubric": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
