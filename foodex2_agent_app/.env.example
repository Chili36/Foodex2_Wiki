OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
FAILURE_ANALYSIS_MODEL=gpt-5.5

FOODEX2_WIKI_API_URL=http://127.0.0.1:8010
FOODEX2_CATALOG_API_URL=http://localhost:5178
FOODEX2_VALIDATOR_API_URL=http://localhost:5178
FOODEX2_SEMANTIC_SEARCH_URL=http://127.0.0.1:8001/search
FOODEX2_SEMANTIC_COLLECTION=mtx_monitoring_openai_current

# FoodEx2 Code Validator routes. The app replaces {code} where present.
FOODEX2_CATALOG_SEARCH_TERMS_PATH=/api/search
FOODEX2_CATALOG_GET_TERM_PATH=/api/term/{code}
FOODEX2_CATALOG_GET_PARENTS_PATH=
FOODEX2_CATALOG_GET_CHILDREN_PATH=
FOODEX2_CATALOG_GET_IMPLICIT_FACETS_PATH=
FOODEX2_CATALOG_SEARCH_FACETS_PATH=/api/search

# Validator path.
FOODEX2_VALIDATOR_VALIDATE_PATH=/api/validate

AGENT_MAX_TOOL_ROUNDS=12
AGENT_TOOL_MODEL_MAX_ITEMS=12
AGENT_TOOL_TRACE_MAX_ITEMS=8
AGENT_TOOL_STRING_MAX_CHARS=700
AGENT_RUN_LOG_DIR=logs
AGENT_FAILURE_LEARNING_LOG=logs/failure_learning.jsonl
AGENT_RUN_LEARNING_LOG=logs/run_learning.jsonl
